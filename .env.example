# Required: easybill API key (Einstellungen -> App-Center -> API in easybill)
EASYBILL_API_KEY=your_api_key_here

# Optional: enable create/update/delete tools. Default is read-only.
# EASYBILL_ENABLE_WRITES=true

# Optional: client-side rate limiting. easybill allows 10 req/min (Professional) or 60 req/min (Premium).
# Set to your plan so the server throttles itself instead of hitting HTTP 429.
# EASYBILL_RATE_LIMIT_PER_MINUTE=10

# Optional: max characters per tool response before truncation (default 25000)
# EASYBILL_CHARACTER_LIMIT=25000

# Optional: request timeout in milliseconds (default 30000)
# EASYBILL_TIMEOUT_MS=30000
